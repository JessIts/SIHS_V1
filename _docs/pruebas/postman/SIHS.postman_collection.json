{
  "info": {
    "_postman_id": "1e1d5356-c768-40ea-9dc3-97f2c264a9f4",
    "name": "SIHS API - Pruebas",
    "description": "Pruebas de API de SIHS con tests automáticos.\n\nRequisitos: backend corriendo, `alembic upgrade head` y `python -m scripts.seed_horarios` (crea el coordinador y la aprendiz que usa la colección).\n\nEjecutar en orden con el Collection Runner: la sesión viaja en la cookie httponly `access_token`, que Postman guarda sola.\n\nLa carpeta 7 (admin) es opcional: llena admin_email y admin_password en el entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{coordinador_email}}\",\n  \"password\": \"ClaveEquivocada1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "",
                  "pm.test(\"Usa el formato de error de la API\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.message).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"No revela si el correo existe\", () => {",
                  "    pm.expect(pm.response.json().message).to.eql(\"Credenciales inválidas.\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login con correo mal formado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-un-correo\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login coordinador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{coordinador_email}}\",\n  \"password\": \"{{coordinador_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Entrega la sesión en una cookie, no en el cuerpo\", () => {",
                  "    pm.expect(pm.cookies.has(\"access_token\")).to.be.true;",
                  "    pm.expect(pm.response.json().data).to.not.have.property(\"access_token\");",
                  "});",
                  "pm.test(\"La cookie es httponly\", () => {",
                  "    const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "    pm.expect(setCookie.toLowerCase()).to.include(\"httponly\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Mi perfil (coordinador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Es coordinador y tiene coordinación asignada\", () => {",
                  "    const user = pm.response.json().data;",
                  "    pm.expect(user.role).to.eql(\"coordinador\");",
                  "    pm.expect(user.coordinacion).to.not.be.null;",
                  "    pm.collectionVariables.set(\"mi_coordinacion\", user.coordinacion.nombre);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
