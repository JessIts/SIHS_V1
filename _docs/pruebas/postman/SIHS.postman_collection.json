    {
      "name": "5. Registro público",
      "item": [
        {
          "name": "5.1 Registro nuevo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Postman\",\n  \"email\": \"{{registro_email}}\",\n  \"phone\": \"3001234567\",\n  \"document_number\": \"{{registro_documento}}\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = Date.now().toString(36);",
                  "pm.collectionVariables.set(\"registro_email\", `Postman.${sufijo}@Example.com`);",
                  "pm.collectionVariables.set(\"registro_documento\", `PM-${sufijo}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "",
                  "pm.test(\"Queda con rol user y el correo en minúsculas\", () => {",
                  "    const user = pm.response.json().data;",
                  "    pm.expect(user.role).to.eql(\"user\");",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"registro_email\").toLowerCase());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Registro con el mismo correo en MAYÚSCULAS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Postman\",\n  \"email\": \"{{registro_email_mayus}}\",\n  \"phone\": \"3001234567\",\n  \"document_number\": \"{{registro_documento}}-2\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verifica la corrección del defecto de correos que distinguían mayúsculas."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"registro_email_mayus\", pm.collectionVariables.get(\"registro_email\").toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"No permite duplicar la cuenta cambiando mayúsculas (409)\", () => pm.response.to.have.status(409));",
                  "",
                  "pm.test(\"Usa el formato de error de la API\", () => {",
