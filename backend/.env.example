APP_NAME=SIHS API
APP_VERSION=1.0.0
DEBUG=true

DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/sihs

# Mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Recuperación de contraseña
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Correo (SMTP). Déjalo vacío en desarrollo: el enlace sale en la consola del backend.
# Ejemplo con Gmail (requiere una "contraseña de aplicación"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tu_correo@gmail.com
#   SMTP_PASSWORD=contraseña_de_aplicacion
#   SMTP_FROM=SIHS <tu_correo@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SIHS <no-reply@sihs.local>
SMTP_USE_TLS=true
